# ============================================================
# Environment Variables — Supply Chain Digital Twin
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# PostgreSQL (production)
DATABASE_URL=postgresql://supply_chain_user:password@localhost:5432/supply_chain_db

# SQLite (local development — uncomment to use)
# DATABASE_URL=sqlite:///./supply_chain.db

# --- MQTT Broker ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=sensors/warehouse

# --- ML Models ---
MODEL_DIRECTORY=./models
LOOKBACK_DAYS=365
FORECAST_HORIZON=30

# --- Simulation ---
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_NUM_SIMULATIONS=100
DEFAULT_LEAD_TIME_MEAN=3.0
DEFAULT_LEAD_TIME_STD=0.5

# --- Inventory Thresholds ---
ALERT_THRESHOLD_PCT=10.0
OVERSTOCK_DOI_THRESHOLD=90
STOCKOUT_HIGH_THRESHOLD=0.30
STOCKOUT_MEDIUM_THRESHOLD=0.15
STOCKOUT_LOW_THRESHOLD=0.05

# --- API ---
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# --- Dashboard ---
BACKEND_URL=http://localhost:8000

# --- Security (leave blank for hackathon MVP) ---
SECRET_KEY=hackathon-demo-secret-key-change-in-production

# --- DB Password (used by Docker Compose) ---
DB_PASSWORD=supply_chain_pass_2026
